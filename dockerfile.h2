# Dockerfile solo para H2 Database
FROM openjdk:17-slim

# Instalar H2 Database
ENV H2_VERSION=2.2.224

RUN apt-get update && \
    apt-get install -y wget && \
    wget https://repo1.maven.org/maven2/com/h2database/h2/${H2_VERSION}/h2-${H2_VERSION}.jar -O /opt/h2.jar && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Crear directorio para datos
RUN mkdir -p /opt/h2-data

WORKDIR /opt

# Exponer puertos
# 1521: TCP Server (conexión JDBC)
# 8082: Web Console
EXPOSE 1521 8082

# Variables de entorno opcionales
ENV H2_OPTIONS="-ifNotExists"

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD java -cp /opt/h2.jar org.h2.tools.Shell \
        -url "jdbc:h2:tcp://localhost:1521/mem:test" \
        -user sa -password "" \
        -sql "SELECT 1" || exit 1

# Iniciar H2 en modo servidor
CMD java -cp /opt/h2.jar org.h2.tools.Server \
    -tcp -tcpAllowOthers -tcpPort 1521 \
    -web -webAllowOthers -webPort 8082 \
    -baseDir /opt/h2-data \
    ${H2_OPTIONS}
