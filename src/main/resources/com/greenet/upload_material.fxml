<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.greenet.UploadMaterialController"
            prefWidth="500" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #F8FFF2, #EAF7DC);">

    <top>
        <HBox alignment="CENTER"
              style="-fx-background-color: linear-gradient(to right, #99CC40, #4CAF50);
                     -fx-padding: 15;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 1);">
            <Label text="Subir Material ♻"
                   style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="➕" onAction="#onNewMaterial"
                    style="-fx-background-color: white;
                           -fx-text-fill: #2E7D32;
                           -fx-font-weight: bold;
                           -fx-background-radius: 50;
                           -fx-padding: 6 12;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 4, 0, 0, 1);"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" alignment="TOP_CENTER" style="-fx-padding: 20;">

            <TextField fx:id="titleField" promptText="Título del material"
                       style="-fx-background-radius: 12; -fx-border-radius: 12;
                              -fx-background-color: white; -fx-border-color: #99CC40;
                              -fx-padding: 8; -fx-pref-width: 420;"/>

            <TextArea fx:id="descriptionArea" promptText="Descripción"
                      prefRowCount="4"
                      style="-fx-background-radius: 12; -fx-border-radius: 12;
                             -fx-background-color: white; -fx-border-color: #99CC40;
                             -fx-padding: 8; -fx-pref-width: 420;"/>

            <ComboBox fx:id="categoryCombo" promptText="Selecciona una categoría"
                      style="-fx-background-radius: 12; -fx-border-radius: 12;
                             -fx-background-color: white; -fx-border-color: #99CC40;
                             -fx-padding: 6; -fx-pref-width: 420;"/>

            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="previewImage" fitHeight="150" fitWidth="300" preserveRatio="true"
                           style="-fx-border-color: #99CC40; -fx-border-radius: 10;
                                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 4, 0, 0, 1);"/>
                <Button text="Subir Imagen" onAction="#onUploadImage"
                        style="-fx-background-color: linear-gradient(to right, #A5D654, #7BC043);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-padding: 8 20;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 6, 0, 0, 1);"/>
            </VBox>

            <VBox fx:id="camposEspecificos" alignment="CENTER" spacing="8" style="-fx-padding: 10;">
                <TextField fx:id="modeloField" promptText="Modelo"
                           style="-fx-background-radius: 12; -fx-border-radius: 12;
                                  -fx-background-color: white; -fx-border-color: #99CC40;
                                  -fx-padding: 6; -fx-pref-width: 380;"/>
                <TextField fx:id="marcaField" promptText="Marca"
                           style="-fx-background-radius: 12; -fx-border-radius: 12;
                                  -fx-background-color: white; -fx-border-color: #99CC40;
                                  -fx-padding: 6; -fx-pref-width: 380;"/>
                <CheckBox fx:id="garantiaCheck" text="Garantía"
                          style="-fx-font-size: 14px; -fx-text-fill: #2E7D32; -fx-padding: 6;"/>
                <TextField fx:id="tallaField" promptText="Talla"
                           style="-fx-background-radius: 12; -fx-border-radius: 12;
                                  -fx-background-color: white; -fx-border-color: #99CC40;
                                  -fx-padding: 6; -fx-pref-width: 380;"/>
                <TextField fx:id="materialField" promptText="Material"
                           style="-fx-background-radius: 12; -fx-border-radius: 12;
                                  -fx-background-color: white; -fx-border-color: #99CC40;
                                  -fx-padding: 6; -fx-pref-width: 380;"/>
                <TextField fx:id="tipoMuebleField" promptText="Tipo de mueble"
                           style="-fx-background-radius: 12; -fx-border-radius: 12;
                                  -fx-background-color: white; -fx-border-color: #99CC40;
                                  -fx-padding: 6; -fx-pref-width: 380;"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="12"
              style="-fx-padding: 0 15 180 15;">
            <Button text="Publicar" onAction="#onSubmit"
                    style="-fx-background-color: linear-gradient(to right, #4CAF50, #2E7D32);
                           -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 25; -fx-padding: 10 28; -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.22), 8, 0, 0, 2);"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVolver" text="⬅ Volver" onAction="#onGoBack"
                    style="-fx-background-color: white; -fx-text-fill: #2E7D32;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 25; -fx-padding: 8 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 6, 0, 0, 1);"/>
        </HBox>
    </bottom>
</BorderPane>
