<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.greenet.Vista_Admin_BloqueosController"
            prefWidth="500" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #F8FFF2, #EAF7DC);">

    <top>
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #99CC40, #4CAF50); -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 20;">
                <Label text="Gestión de Bloqueos 🔒"
                       style="-fx-font-size: 26px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnhome"
                        text="🏠 Inicio"
                        onAction="#OnActionVolverAtras"
                        style="
                            -fx-background-color: white;
                            -fx-text-fill: #2E7D32;
                            -fx-font-size: 16px;
                            -fx-font-weight: bold;
                            -fx-background-radius: 25;
                            -fx-padding: 8 20;
                            -fx-cursor: hand;
                            -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 6, 0, 0, 1);
                        "/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="35" alignment="CENTER"
              style="-fx-padding: 60 40;">

            <Label text="Usuarios con Restricciones"
                   style="-fx-font-size: 22px; -fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>

            <Label text="Seleccione un usuario para bloquear:"
                   style="-fx-font-size: 15px; -fx-text-fill: #4E4E4E; -fx-text-alignment: center;"/>

            <ComboBox fx:id="cbUsuariosRestringidos"
                      prefWidth="260"
                      promptText="Seleccione un usuario..."
                      style="
                          -fx-background-color: white;
                          -fx-border-color: #4CAF50;
                          -fx-border-radius: 12;
                          -fx-background-radius: 12;
                          -fx-font-size: 14px;
                          -fx-text-fill: #2E7D32;
                          -fx-padding: 6;
                      "/>

            <VBox spacing="10" alignment="CENTER">
                <Label text="Usuarios Bloqueados"
                       style="-fx-font-size: 16px; -fx-text-fill: #4E4E4E;"/>
                <Text fx:id="txtNumeroUsuarios"
                      text="0"
                      style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-fill: #2E7D32;"/>
            </VBox>

            <HBox alignment="CENTER">
                <Button fx:id="btnBloquear"
                        text="⛔ Bloquear"
                        onAction="#OnActionBloquearUusario"
                        style="
                            -fx-background-color: linear-gradient(to right, #4CAF50, #2E7D32);
                            -fx-text-fill: white;
                            -fx-font-size: 16px;
                            -fx-font-weight: bold;
                            -fx-background-radius: 25;
                            -fx-padding: 12 30;
                            -fx-cursor: hand;
                            -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 8, 0, 0, 2);
                        "/>
            </HBox>

            <Button fx:id="btnVolver"
                    text="Cerrar sesión"
                    onAction="#OnActionVolver"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #2E7D32;
                        -fx-border-width: 2;
                        -fx-text-fill: #2E7D32;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 20;
                        -fx-border-radius: 20;
                        -fx-padding: 6 20;
                        -fx-cursor: hand;
                        -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 1);
                    "/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              style="-fx-padding: 15;">
            <Label text="© 2025 GreenTech App"
                   style="-fx-text-fill: #7A7A7A; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
