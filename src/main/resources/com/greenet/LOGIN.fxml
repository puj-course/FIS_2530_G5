<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.greenet.LoginController">

    <top>
        <Label text="🌿 GREENET" BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20; -fx-text-fill: #27ae60;">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20;">

            <!-- Panel izquierdo - Formulario -->
            <VBox alignment="CENTER" spacing="20" prefWidth="200">
                <Label text="🔐 INICIO DE SESIÓN"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="📧 Correo" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="correoField" promptText="tu@correo.com" prefWidth="180"/>

                    <Label text="🔒 Contraseña" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField" promptText="Tu contraseña" prefWidth="180"/>

                    <Button text="🚀 INICIAR SESIÓN"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"
                            onAction="#handleLogin" prefWidth="180"/>

                    <Button text="📝 Crear Cuenta"
                            style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true;"
                            onAction="#handleGoToSignup"/>
                </VBox>
            </VBox>

            <!-- Panel derecho - Imagen y menú -->
            <VBox alignment="CENTER" spacing="20" prefWidth="150">
                <MenuButton text="☰ Menú" style="-fx-background-color: #95a5a6; -fx-text-fill: white;">
                    <items>
                        <MenuItem text="ℹ️ Acerca de" />
                        <MenuItem text="⚙️ Configuración" />
                        <MenuItem text="❓ Ayuda" />
                    </items>
                </MenuButton>

                <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/reciclaje.jpg" />
                    </image>
                </ImageView>

                <Label text="♻️ Recicla y Conecta"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <Label text="🌱 Juntos por un planeta más verde"
               style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-padding: 10;"
               BorderPane.alignment="CENTER"/>
    </bottom>
</BorderPane>