<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.greenet.SignupController">

    <top>
        <Label text="🌿 GREENET" BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20; -fx-text-fill: #27ae60;">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">

                <Label text="📝 Crear Cuenta"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Formulario -->
                <VBox spacing="10.0" style="-fx-padding: 25; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">

                    <GridPane hgap="10" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="150"/>
                            <ColumnConstraints prefWidth="250"/>
                        </columnConstraints>

                        <!-- Fila 1: Nombre -->
                        <Label text="👤 Nombre *" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="nombreField" promptText="Ingresa tu nombre" GridPane.columnIndex="1"/>

                        <!-- Fila 2: Apellidos -->
                        <Label text="👥 Apellidos *" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="apellidosField" promptText="Ingresa tus apellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <!-- Fila 3: Fecha Nacimiento -->
                        <Label text="📅 Fecha Nacimiento *" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="fechaNacimientoField" promptText="YYYY-MM-DD" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <!-- Fila 4: Tipo Documento - COMBOBOX -->
                        <Label text="📄 Tipo Documento *" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="tipoDocCombo" promptText="Selecciona tipo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <!-- Fila 5: Número Documento -->
                        <Label text="🔢 Número Documento *" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="numeroDocField" promptText="Número de documento" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <!-- Fila 6: Correo -->
                        <Label text="📧 Correo *" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="correoField" promptText="ejemplo@correo.com" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <!-- Fila 7: Contraseña -->
                        <Label text="🔒 Contraseña *" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="contrasenaField" promptText="Crea una contraseña segura" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <!-- Fila 8: Teléfono -->
                        <Label text="📞 Teléfono" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="telefonoField" promptText="Ej: 3001234567" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <!-- Fila 9: Dirección -->
                        <Label text="🏠 Dirección" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <TextField fx:id="direccionField" promptText="Ej: Cra 123 #45-67" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <!-- Fila 10: Rol - COMBOBOX -->
                        <Label text="👑 Rol *" GridPane.rowIndex="9" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="rolCombo" promptText="Selecciona rol" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                    </GridPane>

                    <!-- Botones -->
                    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button text="✅ Registrarse"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"
                                onAction="#handleSignup"/>

                        <Button text="❌ Cancelar"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20;"
                                onAction="#cancelarRegistro"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <Label text="* Campos obligatorios"
               style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-padding: 10;"
               BorderPane.alignment="CENTER"/>
    </bottom>
</BorderPane>